{
  "name": "yaoma",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postinstall": "prisma generate",
    "vercel-build": "node scripts/vercel-build.mjs",
    "start": "next start",
    "db:local": "node scripts/db-local.mjs",
    "db:migrate": "prisma migrate deploy",
    "db:push-prod": "node scripts/push-db.mjs",
    "db:seed": "tsx --env-file-if-exists=.env prisma/seed.ts",
    "import:fetch": "tsx import/run.ts",
    "import:db": "tsx --env-file-if-exists=.env import/to-db.ts",
    "import:orders": "tsx --env-file-if-exists=.env import/orders-to-db.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "test:smoke": "tsx --env-file-if-exists=.env scripts/smoke-test.ts",
    "storage:s3": "tsx --env-file-if-exists=.env scripts/storage-to-s3.ts",
    "allergens:standard": "tsx --env-file-if-exists=.env scripts/allergens-standard.ts",
    "demo:client": "tsx --conditions=react-server --env-file-if-exists=.env scripts/demo-customer.ts"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/he": "^1.2.3",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "playwright-core": "^1.64.1",
    "postcss": "^8.5.30",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@date-fns/tz": "^1.5.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@stripe/react-stripe-js": "^7.0.0",
    "@stripe/stripe-js": "^10.1.0",
    "date-fns": "^4.4.0",
    "exceljs": "^4.4.0",
    "he": "^2.0.0",
    "next": "^16.4.2",
    "nodemailer": "^10.1.2",
    "otpauth": "^9.5.2",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "prisma": "^7.10.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "stripe": "^23.0.0",
    "zod": "^4.6.7"
  }
}
