# Développement local — copier en .env

DATABASE_URL=postgresql://yaoma@localhost:5433/yaoma
APP_URL=http://localhost:3000
# 32 octets en base64 (chiffrement des clés Stripe / BizPrint / 2FA) : openssl rand -base64 32
APP_ENCRYPTION_KEY=

# E-mails : sans configuration, les e-mails sont écrits dans storage/mails/ (développement)
# RESEND_API_KEY=
# SMTP_URL=
# MAIL_FROM="Yaoma Sushi <commandes@yaoma-sushi.com>"
# Nom affiché dans l'application d'authentification (double authentification du back-office)
# TOTP_ISSUER="Yaoma Sushi"

# Site WordPress source et clé API REST WooCommerce en LECTURE seule (import)
WP_BASE_URL=https://yaoma-sushi.com
WC_CONSUMER_KEY=
WC_CONSUMER_SECRET=

# Facultatif : S3_BUCKET, S3_REGION, S3_ENDPOINT, S3_ACCESS_KEY, S3_SECRET_KEY, S3_PUBLIC_URL,
# PRINTNODE_API_KEY, BIZPRINT_API_URL (tests), DISABLE_WORKER=1
